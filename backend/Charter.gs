/**
 * The TEDxThaltej Charter — the text every selected team member reads and signs during onboarding.
 * Stored as structured lines: a = Article, s = section, c = numbered clause [num, text], i = sub-item, p = paragraph.
 * To amend the Charter, edit the lines here and bump CHARTER_VERSION. Each signature records the SHA-256 of the
 * exact text that was signed, so earlier signatures stay verifiable.
 */
const CHARTER_VERSION = '2026.11';
const CHARTER_TITLE = 'TEDxThaltej Charter';
const CHARTER = [["a","Article 1: Preamble"],["s","1.1 Identity and Purpose"],["c","1.1.1","This Charter shall be known as the TEDxThaltej Charter, hereinafter referred to as “the Charter.”"],["c","1.1.2","The Charter establishes the central governing framework for all activities, operations, and organizational structures conducted under the TEDxThaltej name."],["c","1.1.3","TEDxThaltej operates under licenses granted within the TEDx program of TED Conferences, LLC, and shall remain aligned with the global mission of Ideas Worth Spreading."],["c","1.1.4","The purpose of this Charter is to:"],["i","(a) define governance, authority, and operational structure"],["i","(b) ensure uniformity across all TEDxThaltej activities"],["i","(c) establish accountability, discipline, and transparency"],["i","(d) protect the integrity, reputation, and continuity of TEDxThaltej"],["c","1.1.5","This Charter shall apply to all individuals, teams, committees, and bodies operating under or associated with TEDxThaltej."],["s","1.2 Nature and Non-Commercial Status"],["c","1.2.1","TEDxThaltej shall function as an independently organized, non-commercial, and volunteer-driven initiative."],["c","1.2.2","The organization shall not operate for profit, and no part of its income or resources shall be distributed for personal financial gain."],["c","1.2.3","All activities shall be conducted strictly in compliance with:"],["i","(a) TEDx global guidelines"],["i","(b) applicable laws of the Republic of India"],["i","(c) ethical and community standards"],["c","1.2.4","TEDxThaltej shall maintain neutrality and shall not engage in:"],["i","(a) political campaigning or lobbying"],["i","(b) religious promotion or proselytization"],["i","(c) commercial advertising beyond permitted TEDx norms"],["c","1.2.5","All partnerships, sponsorships, and collaborations shall:"],["i","(a) comply with TEDx regulations"],["i","(b) not influence content, speaker selection, or governance decisions"],["s","1.3 Scope of Governance"],["c","1.3.1","This Charter shall serve as the primary and central governing authority for:"],["i","(a) team structure and membership"],["i","(b) appointment and removal of roles"],["i","(c) internal policies, provisions, and procedures"],["i","(d) disciplinary and ethical frameworks"],["c","1.3.2","The Charter shall apply across all TEDxThaltej licenses, including but not limited to:"],["i","(a) Salon"],["i","(b) Youth"],["i","(c) Women"],["i","(d) any future formats established"],["c","1.3.3","While individual license charters may govern event-specific operations, such charters shall:"],["i","(a) remain subordinate to this Charter"],["i","(b) not contradict its provisions"],["c","1.3.4","In case of inconsistency between this Charter and any other internal document:"],["p","The provisions of this Charter shall prevail"],["c","1.3.5","All policies, sub-charters, and provisions issued under this Charter shall derive their authority from it."],["s","1.4 Continuity and Institutional Intent"],["c","1.4.1","TEDxThaltej is established with the intention of creating a sustainable and long-term institutional framework."],["c","1.4.2","This Charter shall ensure:"],["i","(a) continuity of leadership and operations"],["i","(b) preservation of institutional knowledge"],["i","(c) consistency in governance and decision-making"],["c","1.4.3","All structures defined herein shall be designed to:"],["i","(a) function beyond individual tenures"],["i","(b) maintain stability during transitions"],["i","(c) safeguard organizational identity"],["c","1.4.4","The Charter shall serve as a living document, capable of evolution through formal amendments while preserving its core principles."],["c","1.4.5","All members and stakeholders shall have a continuing obligation to:"],["i","(a) uphold the principles of this Charter"],["i","(b) act in the best interest of TEDxThaltej"],["i","(c) protect its credibility and legacy"],["a","Article 2: Structure of TEDxThaltej"],["s","2.1 Multi-License Framework"],["c","2.1.1","TEDxThaltej shall operate under a multi-license framework, wherein multiple TEDx formats function under the broader TEDxThaltej identity."],["c","2.1.2","Such licenses may include, but are not limited to:"],["i","(a) TEDxThaltej Salon"],["i","(b) TEDxThaltej Youth"],["i","(c) TEDxThaltej Women"],["i","(d) any additional formats approved under TEDx guidelines"],["c","2.1.3","Each license shall:"],["i","(a) operate under its respective TEDx license granted by TED Conferences, LLC"],["i","(b) adhere to TEDx global rules and restrictions"],["i","(c) maintain its own event-specific structure and execution model"],["c","2.1.4","The existence of multiple licenses shall not constitute separate organizations, but shall collectively form part of the TEDxThaltej ecosystem."],["s","2.2 Separation of Licenses"],["c","2.2.1","Each TEDxThaltej license shall be treated as an independent operational unit for the purpose of:"],["i","(a) event planning and execution"],["i","(b) speaker curation and content"],["i","(c) format-specific compliance requirements"],["c","2.2.2","Each license may maintain its own:"],["i","(a) event calendar"],["i","(b) thematic direction"],["i","(c) operational workflows specific to its format"],["c","2.2.3","Such separation shall not extend to:"],["i","(a) governance authority"],["i","(b) team structure"],["i","(c) policy framework"],["p","which shall remain centrally governed under this Charter."],["c","2.2.4","No license shall act in a manner that:"],["i","(a) contradicts the TEDxThaltej Charter"],["i","(b) compromises the reputation of any other TEDxThaltej license"],["i","(c) violates TEDx global guidelines"],["s","2.3 Central Governance Principle"],["c","2.3.1","All TEDxThaltej licenses shall be governed under a centralized governance system established by this Charter."],["c","2.3.2","Central governance shall include, but not be limited to:"],["i","(a) appointment and removal of all roles"],["i","(b) team membership and onboarding"],["i","(c) participation and withdrawal policies"],["i","(d) disciplinary and ethical frameworks"],["i","(e) issuance of policies, provisions, and official documents"],["c","2.3.3","All members, irrespective of the license they are associated with, shall:"],["i","(a) be subject to this Charter"],["i","(b) be part of a unified governance system"],["i","(c) adhere to common rules and standards"],["c","2.3.4","Authority under this system shall be exercised primarily through:"],["i","(a) the Organizer"],["i","(b) the Core Team"],["i","(c) the Council, where applicable"],["p","subject always to the supremacy of the Organizer."],["s","2.4 Operational Alignment Clause"],["c","2.4.1","All TEDxThaltej licenses shall operate in alignment with a unified vision, governance philosophy, and institutional framework."],["c","2.4.2","Operational alignment shall ensure:"],["i","(a) consistency in standards and practices"],["i","(b) uniform application of policies"],["i","(c) coordination across licenses when required"],["c","2.4.3","Shared systems may include:"],["i","(a) common team structures"],["i","(b) unified selection and appointment processes"],["i","(c) centralized documentation and record-keeping"],["i","(d) shared disciplinary and compliance mechanisms"],["c","2.4.4","Nothing in this Article shall be interpreted as merging or dissolving individual licenses; rather, it establishes:"],["p","coordinated functioning under a unified governance system"],["c","2.4.5","The Organizer may, at their discretion:"],["i","(a) integrate or separate operational aspects"],["i","(b) assign or reassign resources across licenses"],["i","(c) ensure alignment in the best interest of TEDxThaltej"],["a","Article 3: Supremacy and Applicability"],["s","3.1 Supremacy of this Charter"],["c","3.1.1","This Charter shall constitute the supreme and binding governing document for all matters relating to TEDxThaltej."],["c","3.1.2","All structures, decisions, policies, and actions undertaken under TEDxThaltej shall derive their authority from this Charter."],["c","3.1.3","No internal rule, guideline, policy, or document shall have validity if it is inconsistent with or contrary to the provisions of this Charter."],["c","3.1.4","This Charter shall have overriding effect over:"],["i","(a) all prior internal documents"],["i","(b) informal practices or customs"],["i","(c) any previously followed governance systems"],["s","3.2 Relationship with License Charters"],["c","3.2.1","All previously existing individual license charters, including those relating to:"],["i","(a) TEDxThaltej Salon"],["i","(b) TEDxThaltej Youth"],["i","(c) or any other format"],["p","are hereby dissolved and rendered inoperative, except as provided under this Article."],["c","3.2.2","Notwithstanding Clause 3.2.1, the Organizer may, if deemed necessary, establish or re-establish license-specific charters or documents."],["c","3.2.3","Any such charter shall:"],["i","(a) derive its authority solely from this Charter"],["i","(b) operate only within the scope permitted by this Charter"],["i","(c) not contradict or override this Charter"],["c","3.2.4","License-specific charters, if issued, shall be limited to:"],["i","(a) event-specific operations"],["i","(b) format-specific compliance requirements"],["i","(c) speaker and content processes"],["p","and shall not govern:"],["i","(a) team structure"],["i","(b) appointments"],["i","(c) disciplinary matters"],["i","(d) central policies"],["s","3.3 Conflict Resolution Mechanism"],["c","3.3.1","In the event of any conflict, inconsistency, or ambiguity between:"],["i","(a) this Charter and any license-specific charter, or"],["i","(b) this Charter and any policy, provision, or document"],["p","the provisions of this Charter shall prevail."],["c","3.3.2","Where a conflict arises between two subordinate documents, the matter shall be resolved in accordance with the interpretation of the Organizer."],["c","3.3.3","The Organizer shall have exclusive authority to:"],["i","(a) interpret the provisions of this Charter"],["i","(b) resolve disputes arising under it"],["i","(c) determine applicability in specific cases"],["c","3.3.4","Such interpretation and decision shall be:"],["p","Final"],["p","Binding"],["p","not subject to internal challenge"],["a","Article 4: Authority of the Organizer"],["s","4.1 Supreme Authority"],["c","4.1.1","The Organizer of TEDxThaltej shall hold the highest and final authority in all matters relating to governance, administration, and operations."],["c","4.1.2","All powers, structures, committees, roles, and processes established under this Charter shall derive their authority from the Organizer."],["c","4.1.3","The Organizer shall be the ultimate decision-making authority across all TEDxThaltej licenses, functions, and activities."],["c","4.1.4","No individual, committee, or body shall exercise authority independently of, or contrary to, the authority of the Organizer."],["s","4.2 Powers and Functions"],["c","4.2.1","The Organizer shall have the authority to govern, regulate, and control all aspects of TEDxThaltej."],["c","4.2.2","Such powers shall include, but not be limited to:"],["i","(a) creation, modification, and dissolution of roles, positions, and committees"],["i","(b) appointment, removal, or replacement of any team member or office bearer"],["i","(c) approval or rejection of speakers, partners, and collaborators"],["i","(d) issuance of policies, provisions, and official documents under the Charter"],["i","(e) enforcement of discipline, ethical standards, and compliance mechanisms"],["i","(f) approval of events, themes, and operational plans"],["i","(g) control over certification, recognition, and official acknowledgments"],["c","4.2.3","The Organizer may exercise these powers:"],["i","(a) directly"],["i","(b) through delegated authority"],["i","(c) through structured processes established under this Charter"],["s","4.3 Delegation of Authority"],["c","4.3.1","The Organizer may delegate specific powers, responsibilities, or functions to:"],["i","(a) members of the Core Team"],["i","(b) Directors or Heads"],["i","(c) committees or designated individuals"],["c","4.3.2","Such delegation shall:"],["i","(a) be defined in scope and duration"],["i","(b) not constitute transfer of ultimate authority"],["i","(c) remain subject to review and withdrawal"],["c","4.3.3","Any authority exercised under delegation shall be deemed to have been exercised under the authority of the Organizer."],["c","4.3.4","The Organizer may, at any time:"],["i","(a) modify the scope of delegation"],["i","(b) revoke delegated authority"],["i","(c) reassume direct control over any function"],["s","4.4 Override and Final Decision Power"],["c","4.4.1","The Organizer shall have the power to override any decision, recommendation, or outcome arising from any process, committee, or body."],["c","4.4.2","This shall include, but not be limited to:"],["i","(a) decisions arising from Council processes"],["i","(b) recommendations of the Core Team"],["i","(c) findings or suggestions of committees"],["i","(d) outcomes of internal procedures or evaluations"],["c","4.4.3","The Organizer may:"],["i","(a) accept"],["i","(b) modify"],["i","(c) reject"],["i","(d) replace"],["p","any such decision or outcome."],["c","4.4.4","The decision of the Organizer shall be:"],["i","(a) final"],["i","(b) binding"],["i","(c) not subject to internal appeal or review"],["c","4.4.5","All members and bodies shall be bound to comply with such decisions without delay or objection."],["a","Article 5: Organizational Structure"],["s","5.1 Definition of Roles"],["c","5.1.1","The organizational structure of TEDxThaltej shall consist of formally defined roles established under the authority of the Organizer."],["c","5.1.2","Roles may include, but are not limited to:"],["i","(a) Director-level positions"],["i","(b) Head-level positions"],["i","(c) Functional or operational roles"],["i","(d) General team members"],["c","5.1.3","Each role shall:"],["i","(a) have a defined scope of responsibilities"],["i","(b) operate within the limits assigned by the Organizer"],["i","(c) be subject to performance expectations and accountability"],["c","5.1.4","No role shall:"],["i","(a) exist without formal recognition under this Charter"],["i","(b) exercise authority beyond its defined scope"],["i","(c) claim independent status outside the TEDxThaltej structure"],["s","5.2 Core Team Composition"],["c","5.2.1","The Core Team shall be the primary operational and advisory body within TEDxThaltej."],["c","5.2.2","The Core Team shall consist of:"],["i","(a) all Director-level members"],["i","(b) all Head-level members"],["c","5.2.3","The Core Team shall function:"],["i","(a) under the supervision of the Organizer"],["i","(b) as a coordinating and advisory body"],["i","(c) to support execution and governance"],["c","5.2.4","The Core Team may:"],["i","(a) assist in operational planning and execution"],["i","(b) provide recommendations on policies and decisions"],["i","(c) participate in structured processes such as Council or internal evaluations"],["c","5.2.5","The Core Team shall not:"],["i","(a) override the authority of the Organizer"],["i","(b) exercise powers beyond those delegated"],["s","5.3 Director-Level Positions"],["c","5.3.1","Director-level positions shall represent the highest level of functional leadership below the Organizer."],["c","5.3.2","Directors shall be responsible for:"],["i","(a) leading specific domains or verticals"],["i","(b) managing teams and workflows within their domain"],["i","(c) ensuring execution in alignment with the Charter"],["c","5.3.3","Directors shall:"],["i","(a) operate under the authority of the Organizer"],["i","(b) be accountable for performance and outcomes"],["i","(c) coordinate with other Directors and Heads"],["c","5.3.4","Director-level positions may include, but are not limited to:"],["i","(a) Director of Applications"],["i","(b) Director of Curation"],["i","(c) Director of Marketing"],["i","(d) Director of Operations"],["i","(e) any other role created under this Charter"],["c","5.3.5","All Director appointments:"],["i","(a) shall be made in accordance with Article 6"],["i","(b) shall require formal approval of the Organizer"],["s","5.4 Creation and Dissolution of Roles"],["c","5.4.1","The Organizer shall have the exclusive authority to:"],["i","(a) create new roles or positions"],["i","(b) modify existing roles"],["i","(c) dissolve any role or position"],["c","5.4.2","The creation of a role shall require:"],["i","(a) a defined title"],["i","(b) a clear scope of responsibilities"],["i","(c) an operational justification"],["c","5.4.3","The Organizer may create roles:"],["i","(a) permanently"],["i","(b) temporarily for specific events or functions"],["c","5.4.4","The dissolution of a role may occur if:"],["i","(a) the role is no longer required"],["i","(b) responsibilities are reassigned"],["i","(c) the role is deemed ineffective or redundant"],["c","5.4.5","Upon dissolution:"],["i","(a) all authority attached to the role shall cease immediately"],["i","(b) responsibilities shall revert to the Organizer or be reassigned"],["c","5.4.6","No individual shall retain any title, authority, or claim once a role has been dissolved."],["a","Article 6: Appointment Framework"],["s","6.1 General Principle of Appointment"],["c","6.1.1","All roles, positions, and offices within TEDxThaltej shall be filled through a formal appointment process established under this Charter."],["c","6.1.2","No individual shall assume, claim, or exercise any role unless:"],["i","(a) duly appointed in accordance with this Article"],["i","(b) formally recognized under the authority of the Organizer"],["c","6.1.3","Appointments shall be based on:"],["i","(a) merit and capability"],["i","(b) demonstrated performance and commitment"],["i","(c) suitability for the responsibilities of the role"],["c","6.1.4","All appointments shall derive their legitimacy from the authority of the Organizer, irrespective of the method used."],["s","6.2 Methods of Appointment"],["p","Appointments may be conducted through either of the following methods, at the discretion of the Organizer."],["s","(A) Direct Appointment"],["c","6.2(A).1","The Organizer may directly appoint any individual to any role without the requirement of a selection process."],["c","6.2(A).2","Such appointment may be based on:"],["i","(a) prior performance"],["i","(b) trust and reliability"],["i","(c) expertise or demonstrated capability"],["i","(d) operational necessity"],["c","6.2(A).3","A direct appointment shall:"],["i","(a) take effect upon formal confirmation by the Organizer"],["i","(b) be binding and valid without further consultation"],["c","6.2(A).4","No individual or body shall challenge or invalidate a direct appointment made by the Organizer."],["s","(B) Council Selection Process"],["c","6.2(B).1","The Organizer may, at their discretion, invoke a Council Selection Process for the appointment of any role."],["c","6.2(B).2","The Council shall consist of all active team members recognized under this Charter."],["c","6.2(B).3","The selection process shall include:"],["i","(a) invitation or submission of applications through designated official channels"],["i","(b) written statements of intent, qualifications, or plans by candidates"],["i","(c) review and evaluation by Council members"],["i","(d) structured discussion or deliberation, where required"],["i","(e) a voting or ranking mechanism to determine preference"],["c","6.2(B).4","All Council proceedings shall be conducted under conditions of:"],["i","(a) confidentiality"],["i","(b) professionalism"],["i","(c) absence of lobbying, campaigning, or undue influence"],["c","6.2(B).5","The outcome of the Council process shall:"],["i","(a) represent a collective recommendation"],["i","(b) not constitute a binding decision"],["c","6.2(B).6","The Organizer shall review the outcome and may:"],["i","(a) accept the recommendation"],["i","(b) modify the result"],["i","(c) reject all candidates"],["i","(d) initiate a fresh process"],["c","6.2(B).7","No appointment arising from the Council process shall be valid unless formally confirmed by the Organizer."],["s","6.3 Applicability Across Roles"],["c","6.3.1","The appointment framework under this Article shall apply to:"],["i","(a) Director-level positions"],["i","(b) Head-level positions"],["i","(c) all other roles established under this Charter"],["c","6.3.2","The Organizer may determine:"],["i","(a) which method of appointment is appropriate for a given role"],["i","(b) whether to invoke or bypass the Council process"],["c","6.3.3","Certain roles, including Director-level positions, may ordinarily be filled through the Council Selection Process; however:"],["i","(a) such practice shall not be mandatory"],["i","(b) the Organizer retains discretion to appoint directly"],["s","6.4 Final Authority Clause"],["c","6.4.1","All appointments, irrespective of method, shall be subject to the final authority of the Organizer."],["c","6.4.2","The Organizer shall have the power to:"],["i","(a) confirm"],["i","(b) alter"],["i","(c) revoke"],["i","(d) reassign"],["p","any appointment at any time."],["c","6.4.3","No appointment shall be considered valid unless:"],["i","(a) formally approved by the Organizer"],["i","(b) recognized under the Charter"],["c","6.4.4","The decision of the Organizer in all matters relating to appointment shall be:"],["i","(a) final"],["i","(b) binding"],["i","(c) not subject to internal appeal"],["a","Article 7: Council Selection Process"],["s","7.1 Definition of Council"],["c","7.1.1","The Council shall consist of all active team members formally recognized under this Charter at the time of invocation."],["c","7.1.2","Membership in the Council shall be:"],["i","(a) automatic upon active team status"],["i","(b) subject to compliance with Charter obligations"],["i","(c) revocable in case of suspension, removal, or disciplinary restriction"],["c","7.1.3","The Council shall function as a collective evaluative body for selection processes invoked under this Article."],["c","7.1.4","The Council shall not constitute an independent decision-making authority and shall operate only within the scope defined herein."],["s","7.2 Invocation"],["s","(A) Initiated by Organizer"],["c","7.2(A).1","The Council Selection Process may be invoked solely at the discretion of the Organizer."],["c","7.2(A).2","Invocation shall specify:"],["i","(a) the role or position under consideration"],["i","(b) the timeline and stages of the process"],["i","(c) the applicable procedures and rules"],["c","7.2(A).3","Upon invocation, all eligible Council members shall be notified through official communication channels."],["s","(B) Optional for Any Role"],["c","7.2(B).1","The Council Selection Process may be applied to any role, including but not limited to Director-level, Head-level, or other positions."],["c","7.2(B).2","No role shall mandatorily require Council selection."],["c","7.2(B).3","The Organizer may:"],["i","(a) invoke the process"],["i","(b) bypass the process"],["i","(c) terminate the process at any stage"],["p","without requirement of justification."],["s","7.3 Application Procedure"],["i","(a) Submission through Designated Email"],["c","7.3(a).1","All candidates shall submit their applications through a designated official email or channel specified at the time of invocation."],["c","7.3(a).2","Applications submitted through any unauthorized or informal medium shall not be considered."],["c","7.3(a).3","All submissions shall be recorded and preserved for review."],["i","(b) Statement of Intent and Qualifications"],["c","7.3(b).1","Each application shall include:"],["i","(a) a statement of intent outlining the candidate’s motivation"],["i","(b) relevant experience, contributions, or qualifications"],["i","(c) a proposed vision, plan, or approach for the role"],["c","7.3(b).2","Incomplete or non-compliant applications may be rejected without consideration."],["s","7.4 Evaluation Stage"],["i","(a) Individual Review"],["c","7.4(a).1","All Council members shall independently review submitted applications."],["c","7.4(a).2","Review shall be based on:"],["i","(a) merit and capability"],["i","(b) clarity and feasibility of intent"],["i","(c) alignment with TEDxThaltej principles"],["i","(b) Collective Discussion"],["c","7.4(b).1","A structured discussion may be conducted through:"],["i","(a) formal meetings"],["i","(b) closed forums or designated platforms"],["c","7.4(b).2","Discussion shall remain:"],["i","(a) respectful and professional"],["i","(b) focused on evaluation of candidates"],["i","(c) free from bias, influence, or external pressure"],["c","7.4(b).3","The Organizer or designated authority may moderate such discussions."],["s","7.5 Voting Mechanism"],["i","(a) Voting Method"],["c","7.5(a).1","Voting may be conducted through:"],["i","(a) secret ballot"],["i","(b) open voting"],["i","(c) ranking or scoring systems"],["p","as determined at the time of invocation."],["c","7.5(a).2","The chosen voting method shall be communicated in advance and applied uniformly."],["i","(b) Compilation of Results"],["c","7.5(b).1","Votes shall be collected and compiled through a designated system or authority."],["c","7.5(b).2","The compiled results shall reflect the collective preference of the Council."],["c","7.5(b).3","The integrity of the voting process shall be maintained at all times."],["s","7.6 Nature of Outcome"],["s","(A) Advisory in Nature"],["c","7.6(A).1","The outcome of the Council Selection Process shall constitute a recommendation only."],["c","7.6(A).2","Such recommendation shall not have independent binding force."],["s","(B) Non-Binding on Organizer"],["c","7.6(B).1","The Organizer shall not be bound by the outcome of the Council process."],["c","7.6(B).2","The Organizer may:"],["i","(a) accept the recommended candidate"],["i","(b) select an alternative candidate"],["i","(c) reject all candidates"],["i","(d) order a re-evaluation or fresh process"],["s","7.7 Final Appointment Authority"],["c","7.7.1","All appointments arising from the Council Selection Process shall require formal confirmation by the Organizer."],["c","7.7.2","No candidate shall be deemed appointed unless:"],["i","(a) approved by the Organizer"],["i","(b) formally issued under the Charter"],["c","7.7.3","The Organizer’s decision shall be final and binding."],["s","7.8 Conduct Regulations"],["i","(a) No Campaigning"],["c","7.8(a).1","Candidates shall not engage in campaigning, promotion, or solicitation of support."],["i","(b) No Lobbying"],["c","7.8(b).1","Any attempt to influence Council members through persuasion, pressure, or inducement is strictly prohibited."],["i","(c) Mandatory Confidentiality"],["c","7.8(c).1","All Council members shall maintain strict confidentiality regarding:"],["i","(a) applications"],["i","(b) discussions"],["i","(c) voting and outcomes"],["c","7.8(c).2","Breach of confidentiality shall constitute a violation subject to disciplinary action."],["s","7.9 Integrity and Compliance"],["c","7.9.1","Any misconduct, manipulation, or violation of this process may result in:"],["i","(a) disqualification of candidates"],["i","(b) invalidation of the process"],["i","(c) disciplinary action against involved members"],["c","7.9.2","The Organizer shall have the authority to take necessary action to preserve the integrity of the process."],["a","Article 8: Membership and Onboarding"],["s","8.1 Entry Process"],["c","8.1.1","Entry into TEDxThaltej shall be initiated through a formal application process."],["c","8.1.2","Applications may be invited through:"],["i","(a) official forms or platforms (including tools such as Google Forms)"],["i","(b) designated communication channels approved by the Organizer"],["i","(c) any other method formally prescribed"],["c","8.1.3","All applicants shall provide:"],["i","(a) personal and contact information"],["i","(b) areas of interest or preferred domains"],["i","(c) relevant experience, skills, or background"],["i","(d) any additional information required by the Organizer"],["c","8.1.4","Submission of an application shall not guarantee selection."],["c","8.1.5","All applications shall be recorded and maintained for evaluation and reference."],["s","8.2 Interview and Selection"],["c","8.2.1","Applicants may be subject to an interview or evaluation process prior to selection."],["c","8.2.2","The interview process may include:"],["i","(a) personal interaction or discussion"],["i","(b) assessment of communication and understanding"],["i","(c) evaluation of suitability for team roles"],["c","8.2.3","The interview and evaluation process shall be conducted by:"],["i","(a) designated team members"],["i","(b) Directors or Heads"],["i","(c) or any authority assigned by the Organizer"],["c","8.2.4","Final selection of applicants shall be made under the authority of the Organizer."],["c","8.2.5","The Organizer may:"],["i","(a) approve or reject any applicant"],["i","(b) select candidates for specific roles or general membership"],["i","(c) modify or bypass the interview process where necessary"],["c","8.2.6","The decision of selection shall be final and not subject to challenge."],["s","8.3 Onboarding Requirements"],["p","No individual shall be recognized as a member of TEDxThaltej unless they complete the formal onboarding process."],["i","(a) Charter Acceptance"],["c","8.3(a).1","The individual shall formally acknowledge and accept the provisions of this Charter."],["c","8.3(a).2","Such acceptance shall constitute agreement to:"],["i","(a) abide by all rules and obligations"],["i","(b) operate within the governance framework established herein"],["i","(b) Confidentiality Agreement"],["c","8.3(b).1","The individual shall enter into a confidentiality agreement."],["c","8.3(b).2","This shall include an obligation to:"],["i","(a) protect sensitive information"],["i","(b) refrain from unauthorized disclosure"],["i","(c) maintain confidentiality during and after association"],["i","(c) Acceptance of Future Amendments"],["c","8.3(c).1","The individual shall agree to be bound by any future amendments or provisions issued under this Charter."],["c","8.3(c).2","Continued participation shall constitute ongoing acceptance of such amendments."],["p","8.3.2 Completion of Onboarding"],["c","8.3.2.1","Onboarding shall be completed through submission of a formal onboarding form or equivalent documented process."],["c","8.3.2.2","Failure to complete onboarding shall result in:"],["i","(a) non-recognition as a member"],["i","(b) denial of participation in any official activities"],["s","8.4 Status of Membership"],["c","8.4.1","Upon successful completion of onboarding, the individual shall be recognized as an active member of TEDxThaltej."],["c","8.4.2","Active membership shall grant:"],["i","(a) eligibility to participate in team activities"],["i","(b) inclusion in Council processes, where applicable"],["i","(c) assignment of roles or responsibilities"],["c","8.4.3","Membership shall remain subject to:"],["i","(a) continued compliance with this Charter"],["i","(b) performance and participation expectations"],["i","(c) disciplinary provisions, where applicable"],["c","8.4.4","Membership may be:"],["i","(a) maintained through active participation"],["i","(b) temporarily inactive without termination, subject to provisions of this Charter"],["i","(c) terminated through withdrawal, removal, or disciplinary action"],["c","8.4.5","No individual shall claim membership status:"],["i","(a) without completion of onboarding"],["i","(b) after termination or withdrawal"],["i","(c) without formal recognition under this Charter"],["a","Article 9: Participation Framework"],["s","9.1 License Selection"],["c","9.1.1","Upon completion of onboarding, each member shall indicate their preferred area of participation across available TEDxThaltej licenses."],["c","9.1.2","License selection shall be made through:"],["i","(a) the onboarding form, or"],["i","(b) any subsequent official process designated by the Organizer"],["c","9.1.3","Members may select licenses including, but not limited to:"],["i","(a) TEDxThaltej Salon"],["i","(b) TEDxThaltej Youth"],["i","(c) TEDxThaltej Women"],["i","(d) any additional formats established"],["c","9.1.4","Selection of a license shall:"],["i","(a) indicate willingness to contribute to that license"],["i","(b) not guarantee assignment to specific roles or responsibilities"],["i","(c) remain subject to organizational requirements"],["c","9.1.5","The Organizer or designated authority may:"],["i","(a) assign or reassign members across licenses"],["i","(b) restrict participation in specific licenses"],["i","(c) modify selections based on operational needs"],["s","9.2 Maximum Participation Limit (Two Licenses)"],["c","9.2.1","No member shall be permitted to actively participate in more than two (2) licenses at any given time."],["c","9.2.2","Participation shall include:"],["i","(a) holding roles or responsibilities"],["i","(b) contributing to planning or execution"],["i","(c) being formally assigned to a license team"],["c","9.2.3","Members selecting more than two licenses during onboarding or any process shall:"],["i","(a) be required to limit their selection to two, or"],["i","(b) have their participation determined by the Organizer"],["c","9.2.4","The Organizer may, in exceptional circumstances:"],["i","(a) permit participation beyond the prescribed limit, or"],["i","(b) restrict participation to fewer than two licenses"],["p","based on performance, workload, or operational considerations."],["s","9.3 Temporary Inactivity Clause"],["c","9.3.1","A member may remain temporarily inactive due to:"],["i","(a) academic commitments"],["i","(b) personal reasons"],["i","(c) health or other circumstances"],["c","9.3.2","Temporary inactivity shall:"],["i","(a) not constitute withdrawal or termination of membership"],["i","(b) not automatically result in disciplinary action"],["c","9.3.3","Members are expected to:"],["i","(a) inform relevant authorities of their inactivity"],["i","(b) avoid undertaking responsibilities they cannot fulfill"],["c","9.3.4","During periods of inactivity:"],["i","(a) the member may not be assigned critical responsibilities"],["i","(b) participation in ongoing operations may be limited"],["c","9.3.5","The Organizer or designated authority may:"],["i","(a) reassign responsibilities held by inactive members"],["i","(b) adjust participation status based on operational needs"],["c","9.3.6","Extended or repeated inactivity may result in:"],["i","(a) review of membership status"],["i","(b) reassignment or removal from roles"],["a","Article 10: Withdrawal and Exit"],["s","10.1 Definition of Withdrawal"],["c","10.1.1","Withdrawal shall mean the voluntary and formal termination of an individual’s association with TEDxThaltej."],["c","10.1.2","Withdrawal shall take effect only upon:"],["i","(a) submission of a formal withdrawal request in accordance with this Article, and"],["i","(b) acknowledgment by the appropriate authority"],["c","10.1.3","Withdrawal shall be distinguished from:"],["i","(a) temporary inactivity under Article 9.3, or"],["i","(b) suspension or removal under disciplinary provisions"],["c","10.1.4","No individual shall be deemed withdrawn unless the procedure under this Article has been duly completed."],["s","10.2 Withdrawal Procedure"],["i","(a) Mandatory Withdrawal Form"],["c","10.2(a).1","Any member seeking to withdraw shall submit a formal Withdrawal Form through designated official channels."],["c","10.2(a).2","The Withdrawal Form shall include:"],["i","(a) confirmation of intent to terminate association"],["i","(b) acknowledgment of obligations and consequences"],["i","(c) declaration regarding pending responsibilities and claims"],["c","10.2(a).3","No informal communication, verbal notice, or implied conduct shall constitute valid withdrawal."],["i","(b) Formal Acknowledgment"],["c","10.2(b).1","Withdrawal shall be considered effective only upon formal acknowledgment by:"],["i","(a) the Organizer, or"],["i","(b) a designated authority acting under the Organizer"],["c","10.2(b).2","Such acknowledgment shall:"],["i","(a) confirm acceptance of withdrawal"],["i","(b) record the effective date of termination"],["s","10.3 Pre-Withdrawal Obligations"],["i","(a) Completion of Responsibilities"],["c","10.3(a).1","Prior to withdrawal, the member shall:"],["i","(a) complete all assigned responsibilities, or"],["i","(b) formally transfer or hand over duties as directed"],["c","10.3(a).2","Failure to ensure proper completion or transition may result in:"],["i","(a) forfeiture of recognition"],["i","(b) disciplinary consideration, where applicable"],["i","(b) Certificate Clearance"],["c","10.3(b).1","It shall be the sole responsibility of the member to:"],["i","(a) request issuance of any pending certificates or recognition"],["i","(b) ensure eligibility requirements are fulfilled prior to withdrawal"],["c","10.3(b).2","All claims for certificates must be made before submission of the Withdrawal Form."],["c","10.3(b).3","No claims shall be entertained after withdrawal becomes effective."],["s","10.4 Post-Withdrawal Effects"],["i","(a) Removal from Records"],["c","10.4(a).1","Upon effective withdrawal, the individual’s name shall be removed from:"],["i","(a) all active team records"],["i","(b) operational structures"],["i","(c) internal communication systems"],["i","(b) Termination of Rights"],["c","10.4(b).1","All rights, privileges, and entitlements associated with membership shall cease immediately upon withdrawal."],["c","10.4(b).2","The individual shall:"],["i","(a) no longer represent TEDxThaltej in any capacity"],["i","(b) not claim association with ongoing or future activities"],["c","10.4(b).3","Post-withdrawal, the individual shall not be entitled to:"],["i","(a) certificates, recognitions, or acknowledgments not already issued"],["i","(b) access to internal systems, data, or communications"],["s","10.5 Rejoining Restrictions"],["c","10.5.1","Withdrawal shall be treated as a complete and final exit from TEDxThaltej."],["c","10.5.2","A withdrawn individual shall not be eligible for rejoining unless:"],["i","(a) explicitly permitted by the Organizer, and"],["i","(b) subject to fresh evaluation and onboarding"],["c","10.5.3","The Organizer may:"],["i","(a) refuse re-entry without providing reasons"],["i","(b) impose conditions for reconsideration"],["c","10.5.4","No individual shall claim any right to rejoin on the basis of past association."],["a","Article 11: Certification and Recognition"],["s","11.1 Eligibility Criteria"],["c","11.1.1","Certificates, recognitions, or any official acknowledgment under TEDxThaltej shall be issued only to individuals who have fulfilled their assigned responsibilities in a satisfactory and complete manner."],["c","11.1.2","Eligibility shall be determined based on:"],["i","(a) completion of assigned tasks and roles"],["i","(b) adherence to timelines and commitments"],["i","(c) compliance with the Charter and internal policies"],["i","(d) quality and integrity of contribution"],["c","11.1.3","Participation alone shall not constitute eligibility unless accompanied by meaningful and verifiable contribution."],["c","11.1.4","The determination of eligibility shall rest with:"],["i","(a) the Organizer, or"],["i","(b) a designated authority acting under the Organizer"],["c","11.1.5","The Organizer may:"],["i","(a) approve or deny issuance of certificates"],["i","(b) withhold recognition in case of incomplete or unsatisfactory performance"],["s","11.2 Issuance Authority"],["c","11.2.1","All certificates, recognitions, and official acknowledgments shall be issued under the authority of the Organizer."],["c","11.2.2","No individual, team, or body shall independently issue or claim to issue any official certificate on behalf of TEDxThaltej."],["c","11.2.3","Certificates shall:"],["i","(a) be issued in an official format"],["i","(b) carry proper identification and authentication"],["i","(c) be recorded and maintained in official records"],["c","11.2.4","The Organizer may delegate administrative aspects of issuance; however:"],["i","(a) final authority shall remain with the Organizer"],["i","(b) all such issuance shall be deemed to be under Organizer authority"],["s","11.3 Pending Certifications"],["c","11.3.1","Members shall be responsible for ensuring that all eligible certifications are requested and processed in a timely manner."],["c","11.3.2","Any claim for pending certification shall:"],["i","(a) be submitted through official channels"],["i","(b) be supported by verification of eligibility"],["c","11.3.3","All pending certification requests must be made prior to withdrawal under Article 10."],["c","11.3.4","Failure to request or secure certification before withdrawal shall result in:"],["i","(a) forfeiture of such claim"],["i","(b) no obligation on TEDxThaltej to issue such certification thereafter"],["s","11.4 Post-Withdrawal Restrictions"],["c","11.4.1","No certificates, recognitions, or official acknowledgments shall be issued to any individual after the effective date of withdrawal."],["c","11.4.2","A withdrawn individual shall not:"],["i","(a) request issuance of any pending certificate"],["i","(b) claim entitlement to recognition not already granted"],["c","11.4.3","Any request made after withdrawal shall:"],["i","(a) be deemed invalid"],["i","(b) not be considered under any circumstance"],["c","11.4.4","The Organizer shall have no obligation to:"],["i","(a) process retrospective claims"],["i","(b) reissue or reconsider recognition post-withdrawal"],["a","Article 12: Charter Provisions and Policies"],["s","12.1 Authority to Issue Provisions"],["c","12.1.1","The Organizer shall have the authority to issue additional provisions, policies, and instruments under this Charter for the purpose of governance, regulation, and operational efficiency."],["c","12.1.2","Such provisions shall:"],["i","(a) derive their authority from this Charter"],["i","(b) operate within the framework established herein"],["i","(c) not contradict or override the provisions of this Charter"],["c","12.1.3","The Organizer may issue provisions:"],["i","(a) independently"],["i","(b) upon recommendation of the Core Team"],["i","(c) following a Council-based process, where deemed appropriate"],["c","12.1.4","The power to issue provisions shall include the power to:"],["i","(a) amend existing provisions"],["i","(b) suspend provisions"],["i","(c) revoke provisions at any time"],["s","12.2 Types of Instruments"],["p","Provisions issued under this Article may take the following forms:"],["s","(A) Policies"],["c","12.2(A).1","Policies shall define general rules, standards, and guidelines applicable across TEDxThaltej."],["c","12.2(A).2","Policies may govern:"],["i","(a) conduct and ethics"],["i","(b) participation and responsibilities"],["i","(c) operational standards"],["s","(B) Sub-Charters"],["c","12.2(B).1","Sub-Charters may be issued for specific domains, functions, or licenses."],["c","12.2(B).2","Sub-Charters shall:"],["i","(a) operate under the authority of this Charter"],["i","(b) define detailed frameworks for specific areas"],["i","(c) not establish independent governance"],["s","(C) Operational Provisions"],["c","12.2(C).1","Operational Provisions shall address specific processes, procedures, or temporary requirements."],["c","12.2(C).2","Such provisions may include:"],["i","(a) process guidelines"],["i","(b) event-specific rules"],["i","(c) administrative or procedural instructions"],["s","12.3 Legitimacy Clause"],["i","(a) Issuance on Official Letterhead"],["c","12.3(a).1","All provisions, policies, and instruments shall be issued on official TEDxThaltej letterhead or through an officially recognized format."],["c","12.3(a).2","Such issuance shall constitute formal recognition and authority under this Charter."],["i","(b) Mandatory Documentation"],["c","12.3(b).1","Each provision shall include:"],["i","(a) a title and classification"],["i","(b) a unique identification or reference number"],["i","(c) date of issuance"],["i","(d) issuing authority"],["c","12.3(b).2","Undocumented or informal provisions shall have no binding effect."],["s","12.4 Binding Effect"],["c","12.4.1","All provisions issued in accordance with this Article shall be:"],["i","(a) binding on all applicable members"],["i","(b) enforceable under this Charter"],["c","12.4.2","All members shall be deemed to have accepted such provisions upon:"],["i","(a) issuance, and"],["i","(b) continued participation within TEDxThaltej"],["c","12.4.3","Failure to comply with such provisions may result in:"],["i","(a) disciplinary action"],["i","(b) restriction of participation"],["i","(c) removal, where applicable"],["s","12.5 Record Maintenance"],["c","12.5.1","All provisions, policies, and instruments shall be:"],["i","(a) recorded in an official register or archive"],["i","(b) maintained in secure and accessible formats"],["c","12.5.2","Records shall be preserved to ensure:"],["i","(a) transparency"],["i","(b) traceability"],["i","(c) institutional continuity"],["c","12.5.3","The Organizer shall designate responsibility for maintaining such records."],["c","12.5.4","All issued provisions shall remain in effect until:"],["i","(a) amended"],["i","(b) superseded"],["i","(c) revoked"],["p","by the Organizer."],["a","Article 13: Governance Bodies"],["s","13A: Core Team"],["s","13A.1 Composition"],["c","13A.1.1","The Core Team shall constitute the primary operational and advisory body within TEDxThaltej."],["c","13A.1.2","The Core Team shall consist of:"],["i","(a) all individuals holding Director-level positions"],["i","(b) all individuals holding Head-level positions"],["c","13A.1.3","Membership in the Core Team shall be:"],["i","(a) contingent upon holding a valid role under this Charter"],["i","(b) automatically terminated upon removal, resignation, or dissolution of such role"],["c","13A.1.4","The composition of the Core Team may change from time to time based on:"],["i","(a) creation or dissolution of roles"],["i","(b) appointment or removal of members"],["i","(c) operational requirements"],["s","13A.2 Functions"],["c","13A.2.1","The Core Team shall function as a coordinating and advisory body under the supervision of the Organizer."],["c","13A.2.2","The functions of the Core Team shall include:"],["i","(a) assisting in planning, coordination, and execution of activities"],["i","(b) facilitating communication between different functional areas"],["i","(c) providing recommendations on policies, processes, and decisions"],["i","(d) supporting implementation of Charter provisions and issued policies"],["i","(e) participating in structured processes such as Council Selection Process"],["c","13A.2.3","The Core Team may:"],["i","(a) propose policies, provisions, or operational changes"],["i","(b) review internal processes and suggest improvements"],["i","(c) assist in evaluation of performance and responsibilities"],["c","13A.2.4","The Core Team shall operate collectively and may hold meetings, discussions, or consultations as required."],["s","13A.3 Limitations"],["c","13A.3.1","The Core Team shall not exercise independent authority beyond that delegated under this Charter."],["c","13A.3.2","The Core Team shall not:"],["i","(a) override or countermand decisions of the Organizer"],["i","(b) create binding policies without Organizer approval"],["i","(c) assume powers not expressly granted"],["c","13A.3.3","All recommendations or actions of the Core Team shall:"],["i","(a) remain advisory in nature unless approved"],["i","(b) be subject to review by the Organizer"],["c","13A.3.4","The Organizer may:"],["i","(a) accept or reject any recommendation"],["i","(b) modify or override any action"],["i","(c) dissolve or reconstitute the Core Team structure"],["c","13A.3.5","No member of the Core Team shall claim authority beyond their assigned role."],["s","13B: Internal Disciplinary Committee (IDC)"],["s","13B.1 Establishment"],["c","13B.1.1","There shall exist a single body known as the Internal Disciplinary Committee (IDC) under this Charter."],["c","13B.1.2","The IDC shall be constituted for the purpose of maintaining discipline, enforcing compliance, and addressing violations within TEDxThaltej."],["c","13B.1.3","The IDC shall function as the designated body for inquiry and review of disciplinary matters."],["s","13B.2 Composition"],["c","13B.2.1","The IDC shall consist of:"],["i","(a) one Chairperson nominated by the Organizer"],["i","(b) five members nominated by the Organizer"],["c","13B.2.2","All members of the IDC shall:"],["i","(a) be individuals of integrity and impartiality"],["i","(b) not have a direct conflict of interest in matters under consideration"],["c","13B.2.3","The Organizer may:"],["i","(a) appoint, replace, or remove any member of the IDC"],["i","(b) reconstitute the IDC as required"],["s","13B.3 Nature"],["c","13B.3.1","The IDC shall function as an independent internal body for the purpose of disciplinary review."],["c","13B.3.2","The IDC shall operate:"],["i","(a) under the authority of this Charter"],["i","(b) within the limits prescribed herein"],["c","13B.3.3","Independence under this clause shall relate to:"],["i","(a) fair evaluation of matters"],["i","(b) objective consideration of facts"],["p","and shall not override the authority of the Organizer."],["s","13B.4 Jurisdiction"],["c","13B.4.1","The IDC shall have jurisdiction over matters including, but not limited to:"],["i","(a) misconduct by members"],["i","(b) violations of the provisions of this Charter"],["i","(c) breach of confidentiality obligations"],["i","(d) ethical violations or professional misconduct"],["c","13B.4.2","The IDC may take cognizance of matters:"],["i","(a) reported by any member or authority"],["i","(b) referred by the Organizer"],["i","(c) identified through internal review"],["s","13B.5 Powers"],["c","13B.5.1","The IDC shall have the power to:"],["i","(a) conduct investigations into alleged violations"],["i","(b) seek information, records, or explanations from concerned individuals"],["i","(c) examine facts and circumstances relevant to the matter"],["c","13B.5.2","The IDC may:"],["i","(a) conduct hearings, where required"],["i","(b) provide an opportunity for the concerned individual to respond"],["c","13B.5.3","Upon completion of inquiry, the IDC shall:"],["i","(a) prepare findings"],["i","(b) recommend appropriate actions or sanctions"],["s","13B.6 Limitations"],["c","13B.6.1","The IDC shall function in an advisory capacity."],["c","13B.6.2","The IDC shall not:"],["i","(a) impose final disciplinary actions independently"],["i","(b) override the authority of the Organizer"],["c","13B.6.3","All recommendations of the IDC shall be:"],["i","(a) submitted to the Organizer"],["i","(b) subject to final decision by the Organizer"],["s","13B.7 Procedure and Fairness"],["c","13B.7.1","All proceedings of the IDC shall adhere to principles of:"],["i","(a) fairness"],["i","(b) confidentiality"],["i","(c) impartiality"],["c","13B.7.2","The concerned individual shall be:"],["i","(a) informed of the allegations"],["i","(b) given an opportunity to respond"],["c","13B.7.3","All proceedings and records shall be maintained securely."],["s","13B.8 Exclusivity Clause"],["c","13B.8.1","Only one Internal Disciplinary Committee (IDC) shall exist across TEDxThaltej."],["c","13B.8.2","No parallel or independent disciplinary body shall be constituted outside this Charter."],["c","13B.8.3","All disciplinary matters shall be routed exclusively through the IDC or directly through the Organizer."],["a","Article 14: Official Documentation"],["s","14.1 Types of Documents"],["c","14.1.1","TEDxThaltej may issue official documents under the authority of this Charter for administrative, operational, and recognition purposes."],["c","14.1.2","Such documents may include, but are not limited to:"],["i","(a) policies and provisions issued under Article 12"],["i","(b) sub-charters and operational frameworks"],["i","(c) certificates and recognitions"],["i","(d) letters of recommendation (LoRs)"],["i","(e) letters of association or confirmation"],["i","(f) official notices, communications, or directives"],["c","14.1.3","All official documents shall:"],["i","(a) be issued in accordance with this Charter"],["i","(b) carry formal identification and authenticity"],["i","(c) be recorded in official records"],["s","14.2 Letterhead Requirement"],["c","14.2.1","All official documents shall be issued on TEDxThaltej official letterhead or an officially recognized digital format."],["c","14.2.2","Issuance on official letterhead shall constitute:"],["i","(a) formal authority"],["i","(b) authenticity of the document"],["i","(c) recognition under this Charter"],["c","14.2.3","No document shall be considered official unless:"],["i","(a) issued on proper letterhead or format"],["i","(b) authorized by the Organizer or a delegated authority"],["c","14.2.4","Unauthorized use of TEDxThaltej name, branding, or letterhead is strictly prohibited and may result in disciplinary action."],["s","14.3 Centralization of LoRs"],["c","14.3.1","All Letters of Recommendation (LoRs) and similar recognitions shall be centralized under this Charter."],["c","14.3.2","No individual, team, or sub-group shall independently issue LoRs outside the framework established herein."],["c","14.3.3","LoRs may be:"],["i","(a) initiated by a member, Core Team, or Council recommendation"],["i","(b) reviewed for eligibility and merit"],["i","(c) issued only upon approval of the Organizer"],["c","14.3.4","All LoRs shall:"],["i","(a) reflect verified contributions"],["i","(b) maintain credibility and integrity of TEDxThaltej"],["i","(c) be recorded in official archives"],["c","14.3.5","The Organizer may:"],["i","(a) approve or reject issuance of any LoR"],["i","(b) define criteria and format for such documents"],["s","14.4 Communication Protocol"],["c","14.4.1","All official communication shall be conducted through approved TEDxThaltej communication channels."],["c","14.4.2","Approved channels may include:"],["i","(a) official email accounts"],["i","(b) designated digital platforms"],["i","(c) officially recognized communication systems"],["c","14.4.3","No individual shall issue official communication:"],["i","(a) from personal accounts"],["i","(b) without authorization"],["i","(c) in a manner representing TEDxThaltej without approval"],["c","14.4.4","All official communication shall:"],["i","(a) be accurate and aligned with the Charter"],["i","(b) maintain professionalism and clarity"],["i","(c) reflect the authority of TEDxThaltej"],["c","14.4.5","The Organizer may:"],["i","(a) authorize specific individuals to communicate officially"],["i","(b) restrict or revoke communication privileges"],["a","Article 15: Removal of Executive Orders"],["s","15.1 Dissolution of Executive Order System"],["c","15.1.1","The system of issuing and governing through Executive Orders, as previously practiced under earlier frameworks or charters, is hereby formally dissolved."],["c","15.1.2","With effect from the enforcement of this Charter:"],["i","(a) no new Executive Orders shall be issued"],["i","(b) no action shall be taken under the authority of Executive Orders"],["c","15.1.3","All prior Executive Orders shall:"],["i","(a) cease to have independent governing effect, and"],["i","(b) remain valid only to the extent that they are consistent with this Charter, until replaced or superseded"],["c","15.1.4","Any reference to Executive Orders in previous documents shall be deemed to refer to provisions issued under this Charter, where applicable."],["s","15.2 Replacement by Provision-Based System"],["c","15.2.1","All governance, regulation, and operational directives shall henceforth be issued through a provision-based system established under Article 12 of this Charter."],["c","15.2.2","Such provisions shall include:"],["i","(a) policies"],["i","(b) sub-charters"],["i","(c) operational provisions"],["i","(d) official directives or instructions"],["c","15.2.3","All provisions issued under Article 12 shall:"],["i","(a) carry formal authority under this Charter"],["i","(b) replace the functional role previously served by Executive Orders"],["c","15.2.4","The provision-based system shall ensure:"],["i","(a) clarity and documentation"],["i","(b) traceability of decisions"],["i","(c) consistency in governance"],["c","15.2.5","The Organizer shall retain full authority to:"],["i","(a) issue, amend, suspend, or revoke such provisions"],["i","(b) determine their scope and applicability"],["a","Article 16: Ethics and Conduct"],["s","16.1 Code of Conduct"],["c","16.1.1","All members of TEDxThaltej shall conduct themselves with integrity, respect, and professionalism in all interactions and activities."],["c","16.1.2","Members shall:"],["i","(a) act in the best interest of TEDxThaltej"],["i","(b) maintain respectful and inclusive behavior toward all individuals"],["i","(c) uphold fairness, honesty, and accountability"],["c","16.1.3","The following conduct is strictly prohibited:"],["i","(a) harassment, discrimination, or intimidation of any kind"],["i","(b) misuse of authority, position, or resources"],["i","(c) behavior that damages the reputation or integrity of TEDxThaltej"],["i","(d) any form of unethical or unprofessional conduct"],["c","16.1.4","Members shall comply with:"],["i","(a) this Charter"],["i","(b) all policies and provisions issued under it"],["i","(c) directions issued by authorized authorities"],["c","16.1.5","Violation of the Code of Conduct may result in disciplinary action under this Charter."],["s","16.2 Confidentiality"],["c","16.2.1","All members shall maintain strict confidentiality with respect to internal information of TEDxThaltej."],["c","16.2.2","Confidential information shall include, but not be limited to:"],["i","(a) internal discussions and decisions"],["i","(b) documents, records, and communications"],["i","(c) personal or organizational data"],["i","(d) any information designated as confidential"],["c","16.2.3","Members shall not:"],["i","(a) disclose confidential information without authorization"],["i","(b) use such information for personal or external benefit"],["i","(c) share internal matters with unauthorized individuals"],["c","16.2.4","Confidentiality obligations shall:"],["i","(a) remain in effect during membership"],["i","(b) continue even after withdrawal or termination"],["c","16.2.5","Breach of confidentiality shall constitute a serious violation and may result in strict disciplinary action."],["s","16.3 Professional Standards"],["c","16.3.1","Members shall perform their duties with diligence, responsibility, and commitment."],["c","16.3.2","Members shall:"],["i","(a) adhere to assigned responsibilities and timelines"],["i","(b) communicate effectively and professionally"],["i","(c) maintain reliability and accountability in their roles"],["c","16.3.3","Members shall avoid:"],["i","(a) conflicts of interest"],["i","(b) negligence or failure to perform assigned duties"],["i","(c) conduct that disrupts team functioning or operations"],["c","16.3.4","All work carried out under TEDxThaltej shall meet standards of:"],["i","(a) quality"],["i","(b) consistency"],["i","(c) alignment with TEDx principles"],["c","16.3.5","Failure to meet professional standards may result in:"],["i","(a) reassignment of responsibilities"],["i","(b) removal from roles"],["i","(c) disciplinary action, where applicable"],["a","Article 17: Enforcement and Sanctions"],["s","17.1 Authority of Enforcement"],["c","17.1.1","The authority to enforce the provisions of this Charter shall vest exclusively in the Organizer."],["c","17.1.2","The Organizer may exercise enforcement:"],["i","(a) directly, or"],["i","(b) through bodies constituted under this Charter, including the Internal Disciplinary Committee (IDC)"],["c","17.1.3","The Organizer shall have the power to:"],["i","(a) initiate inquiries into alleged violations"],["i","(b) determine whether a breach has occurred"],["i","(c) impose appropriate sanctions"],["c","17.1.4","Recommendations from any body, including the IDC, shall:"],["i","(a) assist in evaluation, and"],["i","(b) remain subject to final decision by the Organizer"],["s","17.2 Types of Sanctions"],["p","Sanctions may be imposed depending on the nature, severity, and impact of the violation."],["i","(a) Warning"],["c","17.2(a).1","A warning shall constitute a formal notice of misconduct."],["c","17.2(a).2","Warnings may be issued for:"],["i","(a) minor violations"],["i","(b) first-time infractions"],["i","(c) conduct requiring correction"],["i","(b) Suspension"],["c","17.2(b).1","Suspension shall involve temporary removal from duties, roles, or participation."],["c","17.2(b).2","During suspension, the individual shall:"],["i","(a) not exercise any role or authority"],["i","(b) have restricted access to internal systems or activities"],["i","(c) Removal"],["c","17.2(c).1","Removal shall involve termination from a specific role or position."],["c","17.2(c).2","Removal may occur where:"],["i","(a) performance is unsatisfactory"],["i","(b) responsibilities are not fulfilled"],["i","(c) conduct violates Charter provisions"],["c","17.2(c).3","Removal from a role shall not necessarily terminate membership unless specified."],["i","(d) Blacklisting"],["c","17.2(d).1","Blacklisting shall constitute a prohibition from participation in TEDxThaltej activities."],["c","17.2(d).2","Blacklisting may be:"],["i","(a) temporary, or"],["i","(b) permanent, as determined by the Organizer"],["c","17.2(d).3","A blacklisted individual shall:"],["i","(a) not be eligible for roles, participation, or recognition"],["i","(b) not represent or associate with TEDxThaltej"],["s","17.3 Procedure"],["c","17.3.1","Any alleged violation may be:"],["i","(a) reported by a member"],["i","(b) identified through internal review"],["i","(c) referred by the Organizer"],["c","17.3.2","The Organizer may:"],["i","(a) initiate direct action, or"],["i","(b) refer the matter to the IDC for investigation"],["c","17.3.3","Where an inquiry is conducted:"],["i","(a) the concerned individual shall be informed of the matter"],["i","(b) an opportunity to respond may be provided"],["c","17.3.4","Upon completion of review or investigation:"],["i","(a) findings shall be considered"],["i","(b) appropriate sanction shall be determined"],["c","17.3.5","Sanctions shall:"],["i","(a) be proportionate to the violation"],["i","(b) take effect immediately unless stated otherwise"],["c","17.3.6","The decision of the Organizer shall be:"],["i","(a) final"],["i","(b) binding"],["i","(c) not subject to internal appeal"],["a","Article 18: Amendments"],["s","18.1 Authority to Amend"],["c","18.1.1","The authority to amend, modify, add to, or repeal any provision of this Charter shall vest exclusively in the Organizer."],["c","18.1.2","No individual, committee, or body shall independently amend or alter this Charter."],["c","18.1.3","The Organizer may exercise the power of amendment:"],["i","(a) on their own initiative, or"],["i","(b) upon recommendation from the Core Team or Council"],["c","18.1.4","Such recommendations, if any, shall:"],["i","(a) be advisory in nature, and"],["i","(b) not bind the Organizer"],["s","18.2 Process of Amendment"],["c","18.2.1","All amendments shall be made through formal issuance under this Charter."],["c","18.2.2","An amendment shall:"],["i","(a) clearly specify the provision being amended, added, or repealed"],["i","(b) include the effective date of implementation"],["i","(c) be documented in official records"],["c","18.2.3","Amendments may take the form of:"],["i","(a) modification of existing Articles or clauses"],["i","(b) insertion of new Articles or sub-clauses"],["i","(c) removal or replacement of provisions"],["c","18.2.4","All amendments shall be:"],["i","(a) communicated to relevant members through official channels"],["i","(b) incorporated into the Charter framework"],["s","18.3 Effect of Amendments"],["c","18.3.1","All amendments shall have binding effect from the date of implementation, unless otherwise specified."],["c","18.3.2","All members shall be deemed to have accepted amendments by virtue of:"],["i","(a) prior onboarding agreement under Article 8, and"],["i","(b) continued participation in TEDxThaltej"],["c","18.3.3","No amendment shall:"],["i","(a) conflict with applicable TEDx guidelines, or"],["i","(b) violate applicable laws"],["c","18.3.4","Upon amendment:"],["i","(a) the revised provision shall replace the previous version"],["i","(b) all actions shall thereafter be governed by the amended provision"],["a","Article 19: Dissolution"],["s","19.1 Conditions for Dissolution"],["c","19.1.1","TEDxThaltej may be dissolved under the following circumstances:"],["i","(a) revocation or non-renewal of the TEDx license by TED Conferences, LLC"],["i","(b) voluntary decision of the Organizer to discontinue operations"],["i","(c) inability to continue operations due to legal, administrative, or operational constraints"],["c","19.1.2","The determination of dissolution shall rest solely with the Organizer, except where mandated by external authority."],["s","19.2 Procedure"],["s","(A) Issuance of Dissolution Order"],["c","19.2(A).1","Dissolution shall be effected through a formal Dissolution Order issued under this Charter."],["c","19.2(A).2","The Dissolution Order shall:"],["i","(a) specify the effective date of dissolution"],["i","(b) state the reason or basis for dissolution"],["i","(c) define any transitional or concluding arrangements"],["s","(B) Handling of Assets"],["c","19.2(B).1","All assets associated with TEDxThaltej, including but not limited to:"],["i","(a) financial resources"],["i","(b) physical materials and equipment"],["i","(c) digital assets, records, and accounts"],["p","shall be handled in accordance with:"],["i","(a) applicable laws, and"],["i","(b) TEDx guidelines"],["c","19.2(B).2","No asset shall be:"],["i","(a) distributed for personal gain, or"],["i","(b) misused or transferred without authorization"],["c","19.2(B).3","The Organizer shall determine the appropriate method of:"],["i","(a) transfer"],["i","(b) archival"],["i","(c) closure"],["p","of such assets."],["s","19.3 Effects"],["i","(a) Termination of Roles"],["c","19.3(a).1","Upon dissolution, all roles, positions, and authorities established under this Charter shall:"],["i","(a) cease immediately, and"],["i","(b) have no further effect"],["i","(b) Closure of Operations"],["c","19.3(b).1","All activities, operations, and functions of TEDxThaltej shall be formally terminated."],["c","19.3(b).2","All stakeholders shall be notified of dissolution through official communication."],["c","19.3(b).3","No individual shall:"],["i","(a) represent TEDxThaltej post-dissolution, or"],["i","(b) claim authority or association with it"],["a","Article 20: Liability, Responsibility, and Indemnity"],["s","20.1 Allocation of Responsibility"],["c","20.1.1","All actions undertaken within TEDxThaltej shall be deemed to be performed by individuals in their personal or assigned capacity."],["c","20.1.2","Responsibility for any act, omission, or decision shall rest solely with:"],["i","(a) the individual performing such act, and"],["i","(b) the role under which such act is performed"],["c","20.1.3","No act of any member shall be attributed to the Organizer solely by virtue of their position."],["s","20.2 Limitation of Organizer Liability"],["c","20.2.1","To the maximum extent permissible under applicable law, the Organizer shall not be held liable for:"],["i","(a) acts, omissions, or decisions of any member"],["i","(b) misconduct, negligence, or violations by any individual"],["i","(c) unauthorized actions taken in the name of TEDxThaltej"],["c","20.2.2","The Organizer shall not be personally responsible for:"],["i","(a) operational decisions executed by team members"],["i","(b) outcomes arising from delegated authority"],["i","(c) actions taken without explicit written approval"],["c","20.2.3","All members acknowledge that the Organizer functions in a governance capacity, and not as a personal guarantor of all actions."],["s","20.3 Member Liability"],["c","20.3.1","Each member shall bear full and independent responsibility for:"],["i","(a) their actions and decisions"],["i","(b) compliance with this Charter"],["i","(c) consequences arising from their conduct"],["c","20.3.2","Any act beyond assigned authority shall:"],["i","(a) be deemed unauthorized, and"],["i","(b) remain the sole liability of the individual"],["s","20.4 Indemnity"],["c","20.4.1","All members shall indemnify and hold harmless the Organizer and TEDxThaltej from:"],["i","(a) claims, losses, or damages arising from their actions"],["i","(b) liabilities caused by misconduct or negligence"],["i","(c) consequences of violation of this Charter"],["c","20.4.2","Such indemnity shall apply irrespective of whether the act was intentional or negligent."],["s","20.5 Exclusion of Personal Liability"],["c","20.5.1","The Organizer shall not be personally liable for any:"],["i","(a) indirect or consequential losses"],["i","(b) reputational or operational damages"],["i","(c) claims arising from team conduct"],["c","20.5.2","All risks associated with participation shall be deemed accepted by members."],["s","20.6 Good Faith Protection"],["c","20.6.1","No liability shall arise against the Organizer for any act done:"],["i","(a) in good faith, and"],["i","(b) in furtherance of TEDxThaltej operations"],["s","20.7 Legal Supremacy Clause"],["c","20.7.1","This Article shall be interpreted to provide the maximum protection permissible under applicable law."],["c","20.7.2","If any provision is found unenforceable, the remaining provisions shall continue in full force."],["a","Article 21: Override Clause"],["s","21.1 Power of Override"],["c","21.1.1","Notwithstanding anything contained in this Charter, the Organizer of TEDxThaltej shall have full and unrestricted authority to override, suspend, modify, or depart from any Article, Section, or Clause of this Charter."],["c","21.1.2","Such authority may be exercised at the sole and absolute discretion of the Organizer where they consider it necessary or beneficial for:"],["i","(a) the integrity, reputation, or continuity of TEDxThaltej;"],["i","(b) alignment with TEDx principles or expectations;"],["i","(c) effective governance, execution, or operational necessity."],["c","21.1.3","The satisfaction of the Organizer under this Article shall be final, binding, and not subject to prior approval, challenge, or review."],["s","21.2 Legal Effect"],["c","21.2.1","Any action taken under this Article shall:"],["i","(a) have immediate force and effect;"],["i","(b) prevail over all other provisions of this Charter;"],["i","(c) remain valid notwithstanding any inconsistency with any Article of this Charter."],["c","21.2.2","No provision of this Charter shall limit or restrict the exercise of powers under this Article."],["s","21.3 Mandatory Recording and Communication"],["c","21.3.1","The Organizer shall record the exercise of override authority in an official written form."],["c","21.3.2","Such decision shall be communicated to the Core Team within a reasonable time for record purposes."],["s","21.4 Activation of IDC Review Mechanism"],["c","21.4.1","Upon invocation of this Article, the Internal Disciplinary Committee (IDC) shall automatically stand activated in a review capacity."],["c","21.4.2","The IDC shall:"],["i","(a) examine the circumstances and implications of the override;"],["i","(b) record observations regarding alignment with the stated purposes under Clause 21.1.2;"],["i","(c) maintain official documentation of such review."],["c","21.4.3","The IDC shall not have authority to:"],["i","(a) suspend, reverse, modify, or block any action of the Organizer;"],["i","(b) issue binding directions against the Organizer."],["c","21.4.4","The role of the IDC shall be strictly limited to:"],["p","a non-binding institutional check and record of accountability"],["s","21.5 Continuity of Organizer Authority"],["c","21.5.1","Nothing in this Article shall be interpreted as limiting or diminishing:"],["i","(a) the powers of the Organizer under Article 4;"],["i","(b) the finality of decisions exercised under this Article."],["c","21.5.2","All actions taken under this Article shall be deemed actions taken in official capacity under the Charter."],["s","21.6 Special Application of Liability (Override of Article 20)"],["p","21.6.1 Enhanced Protection of Organizer"],["p","Notwithstanding anything contained in Article 20:"],["i","(a) all protections, immunities, and limitations of liability available to the Organizer shall continue in full force and shall be interpreted in the widest possible manner;"],["i","(b) any action taken under this Article shall be conclusively deemed to be:"],["p","in good faith; and"],["p","in furtherance of TEDxThaltej operations"],["p","for the purposes of Article 20;"],["i","(c) no liability, direct or indirect, shall arise against the Organizer for any act, omission, or consequence arising from the exercise of powers under this Article."],["p","21.6.2 Restriction of Member Protections"],["p","Upon invocation of this Article:"],["i","(a) all protections, indemnities, and limitations of liability available to members under Article 20 shall stand suspended to the extent they relate to actions connected with such override;"],["i","(b) no member shall claim protection under Article 20 for acts performed pursuant to or arising from the override."],["p","21.6.3 Personal Liability of Members"],["p","Any member acting:"],["i","(a) in execution of an override directive; or"],["i","(b) beyond assigned authority during the period of such override"],["p","shall bear full and independent responsibility for:"],["p","their actions"],["p","compliance"],["p","and all resulting consequences"],["p","notwithstanding any provision of Article 20."],["p","21.6.4 Non-Attribution to Organizer"],["p","No act performed by any member during the operation of this Article shall:"],["i","(a) be attributed to the Organizer; or"],["i","(b) create any form of vicarious liability upon the Organizer"],["p","by virtue of direction, authorization, or association."],["a","Article 22: Institutional Safeguards During Override"],["s","22.1 Activation and Applicability"],["c","22.1.1","This Article shall automatically come into force upon invocation of Article 21."],["c","22.1.2","The operation of this Article shall continue for the entire duration of the override and shall apply to all actions, decisions, and processes undertaken therein."],["s","22.2 Continuity of Organizer Authority"],["c","22.2.1","Nothing in this Article shall:"],["i","(a) restrict, dilute, or limit the authority of the Organizer under Article 21;"],["i","(b) affect the legality, validity, or enforceability of any override decision."],["s","22.3 Institutional Nature of Decision-Making"],["c","22.3.1","All decisions taken during the operation of Article 21 shall be deemed to be institutional decisions of TEDxThaltej."],["c","22.3.2","Such decisions shall not be construed as solely personal decisions of the Organizer, but as outcomes arising from the collective functioning of the organization under authorized override conditions."],["c","22.3.3","Members engaged in execution, review, or implementation of such decisions shall be recognized as acting in an official institutional capacity."],["s","22.4 Protected Execution of Members"],["c","22.4.1","Any member acting:"],["i","(a) pursuant to an override directive; and"],["i","(b) within the scope of assigned roles and responsibilities"],["p","shall be deemed to be acting under institutional authority."],["c","22.4.2","No such member shall bear independent or personal liability for:"],["i","(a) the substance, nature, or direction of the decision;"],["i","(b) consequences arising directly from such decision."],["c","22.4.3","Member responsibility shall be limited strictly to:"],["i","(a) good faith execution;"],["i","(b) adherence to assigned scope;"],["i","(c) procedural integrity and ethical conduct."],["s","22.5 Attribution and Responsibility Framework"],["c","22.5.1","Actions performed during the operation of Article 21 shall be attributed to the institutional process of TEDxThaltej operating under override conditions."],["c","22.5.2","No act performed by a member in compliance with an override directive shall be treated as an independent personal act."],["c","22.5.3","Responsibility for such actions shall be interpreted in a collective and institutional context, rather than as individual liability of executing members."],["s","22.6 IDC Oversight and Record Maintenance"],["c","22.6.1","Upon invocation of Article 21, the Internal Disciplinary Committee (IDC) shall:"],["i","(a) record the invocation of override and its stated purpose;"],["i","(b) document the directives issued and their scope;"],["i","(c) maintain records of actions taken during the override period;"],["i","(d) record observations on procedural consistency and institutional alignment."],["c","22.6.2","Such records shall:"],["i","(a) serve as official institutional documentation;"],["i","(b) not interfere with or delay execution of decisions;"],["i","(c) not constitute a challenge to the authority of the Organizer."],["s","22.7 Preservation of Member Protection Framework"],["c","22.7.1","Notwithstanding any provision of Article 20 or Article 21.6:"],["i","(a) members acting within authorized scope during override shall retain protection against disproportionate or independent liability;"],["i","(b) liability, if any, shall be interpreted in light of directive-based execution and institutional responsibility."],["s","22.8 Institutional Integrity Principle"],["c","22.8.1","The operation of Article 21 shall be understood as the functioning of TEDxThaltej in a unified institutional capacity, and not as the exercise of isolated individual authority."],["c","22.8.2","All actions undertaken during such period shall be treated as actions of the organization as a whole, executed through its members in accordance with assigned roles."],["a","Article 23: Institutional Hearing and Right to Information Framework"],["s","23.1 Purpose"],["c","23.1.1","This Article establishes a structured framework for transparency, clarification, and institutional accountability."],["c","23.1.2","It enables:"],["i","(a) access to information;"],["i","(b) structured questioning;"],["i","(c) institutional dialogue in matters of significance."],["s","23.2 Dual Mechanism Under this Article"],["c","23.2.1","This Article shall operate through two mechanisms:"],["i","(a) Right to Information (RTI) — exercisable individually by Council members;"],["i","(b) Institutional Hearing — exercisable upon two-thirds (2/3) majority of the Council."],["s","23.3 Right to Information (RTI)"],["p","23.3.1 Individual Invocation"],["p","Any Council member may invoke RTI individually, without requiring any majority."],["p","23.3.2 Scope of RTI"],["p","RTI may be exercised for:"],["i","(a) decisions affecting governance or operations;"],["i","(b) invocation or execution of Article 21;"],["i","(c) actions impacting roles, structure, or disciplinary matters;"],["i","(d) any matter reasonably connected to institutional functioning."],["p","23.3.3 Authority During RTI"],["p","Upon invocation:"],["i","(a) the Organizer shall provide reasonable clarification, reasoning, or context;"],["i","(b) relevant non-confidential information shall be made available where appropriate."],["p","23.3.4 Procedural Position"],["p","For the limited purpose of RTI, this Article shall operate as a procedural enabling provision, allowing structured questioning and clarification notwithstanding the general operation of Article 4."],["p","23.3.5 Limitations"],["p","RTI shall:"],["i","(a) not invalidate or modify any decision;"],["i","(b) not delay operations;"],["i","(c) respect confidentiality and institutional integrity."],["s","23.4 Institutional Hearing (2/3 Majority)"],["p","23.4.1 Invocation"],["p","An Institutional Hearing may be invoked where:"],["i","(a) at least two-thirds (2/3) of Council members support it;"],["i","(b) the matter is of significant institutional importance."],["p","23.4.2 Effect of Invocation"],["p","Upon invocation:"],["i","(a) this Article shall operate with procedural precedence for the duration of the hearing;"],["i","(b) a structured session of clarification and questioning shall be conducted."],["p","23.4.3 Authority During Hearing"],["p","During the hearing:"],["i","(a) the Organizer may be formally required to provide explanations, reasoning, and justification;"],["i","(b) Council members may ask structured questions within the defined scope."],["p","23.4.4 Temporary Procedural Moderation"],["p","For the duration of the hearing, the strict operational finality associated with Article 4 shall be procedurally moderated solely for the purpose of meaningful institutional questioning and clarification."],["p","23.4.5 Nature of Moderation"],["p","Such moderation shall:"],["i","(a) enable open questioning and dialogue;"],["i","(b) not constitute removal or reduction of authority;"],["i","(c) exist only for the duration of the hearing."],["s","23.5 Limitations"],["c","23.5.1","Nothing under this Article shall:"],["i","(a) invalidate, suspend, or modify any decision;"],["i","(b) override Article 21;"],["i","(c) create an appeal or adjudicatory mechanism."],["c","23.5.2","All decisions of the Organizer shall remain:"],["i","(a) final;"],["i","(b) binding;"],["i","(c) enforceable."],["s","23.6 Record and Documentation"],["c","23.6.1","All RTI requests and hearings shall be documented formally and maintained as institutional records."],["c","23.6.2","Records shall include:"],["i","(a) subject of inquiry;"],["i","(b) clarifications provided;"],["i","(c) key observations."],["s","23.7 Institutional Integrity Clause"],["c","23.7.1","This Article shall function as a mechanism of transparency, structured accountability, and institutional clarity."],["c","23.7.2","It shall not be interpreted as diminishing the authority of the Organizer, but as ensuring that such authority remains transparent and explainable within the institutional framework."],["a","Article 24: Senior Advisors and Exceptional IDC Authority"],["s","24.1 Establishment of Senior Advisors"],["c","24.1.1","The Organizer may appoint one or more Senior Advisors to the Organizer."],["c","24.1.2","Senior Advisors shall serve as senior institutional advisors on matters relating to governance, compliance, ethics, continuity, and organizational integrity."],["c","24.1.3","Senior Advisors shall be deemed active members of TEDxThaltej."],["c","24.1.4","Senior Advisors shall be members of the Council and shall enjoy all rights and privileges associated with Council membership."],["c","24.1.5","Senior Advisors may participate in Council proceedings, Institutional Hearings, and governance consultations."],["s","24.2 IDC Chairperson"],["c","24.2.1","The Chairperson of the Internal Disciplinary Committee shall be appointed from among the Senior Advisors."],["c","24.2.2","The Organizer may appoint, replace, or remove the IDC Chairperson."],["c","24.2.3","The IDC Chairperson shall preside over all proceedings of the IDC and exercise such powers as may be necessary for the discharge of IDC functions."],["s","24.3 Exceptional Constitutional Review Authority"],["c","24.3.1","Notwithstanding anything contained in this Charter, the IDC shall possess Exceptional Constitutional Review Authority."],["c","24.3.2","Such authority may be invoked where there exists a credible allegation of:"],["i","(a) favoritism, partiality, or unequal treatment;"],["i","(b) abuse or misuse of authority;"],["i","(c) actions inconsistent with the Charter;"],["i","(d) actions threatening the integrity of TEDxThaltej governance;"],["i","(e) misuse of override powers under Article 21;"],["i","(f) any matter of exceptional institutional importance."],["c","24.3.3","Exceptional Constitutional Review Authority may be invoked only upon:"],["i","(a) a resolution supported by not less than two-thirds (2/3) of the Council; and"],["i","(b) acceptance of jurisdiction by the IDC Chairperson."],["s","24.4 Suspension of Articles 3 and 4"],["c","24.4.1","Upon valid invocation of this Article, Articles 3 and 4 shall stand suspended solely for the matter under review."],["c","24.4.2","During such suspension:"],["i","(a) the supremacy provisions of Article 3 shall not apply to the matter under review;"],["i","(b) the finality provisions of Article 4 shall not apply to the matter under review;"],["i","(c) no decision of the Organizer relating to the matter under review shall be deemed final until conclusion of the IDC proceedings."],["c","24.4.3","Such suspension shall remain limited strictly to the specific matter under consideration and shall not affect unrelated decisions."],["s","24.5 Powers of the IDC During Review"],["c","24.5.1","During the exercise of Exceptional Constitutional Review Authority, the IDC may:"],["i","(a) require production of records, communications, and documents;"],["i","(b) summon members, office bearers, or authorities for explanation;"],["i","(c) conduct hearings and receive submissions;"],["i","(d) examine compliance with the Charter;"],["i","(e) determine whether favoritism, partiality, abuse of authority, or Charter violations have occurred."],["c","24.5.2","All members and authorities shall cooperate fully with the IDC."],["s","24.6 Binding Determination"],["c","24.6.1","Upon completion of proceedings, the IDC shall issue a written determination."],["c","24.6.2","Such determination shall:"],["i","(a) contain findings of fact;"],["i","(b) contain conclusions regarding compliance with the Charter;"],["i","(c) specify corrective measures, where necessary."],["c","24.6.3","Notwithstanding any other provision of this Charter, an IDC determination issued under this Article shall be final and binding in relation to the matter reviewed."],["c","24.6.4","The Organizer, Council, Core Team, and all members shall comply with such determination."],["s","24.7 Restoration of Constitutional Order"],["c","24.7.1","Upon issuance of the final determination, Articles 3 and 4 shall automatically resume full force and effect."],["c","24.7.2","Nothing in this Article shall be interpreted as permanently diminishing the authority of the Organizer except to the extent necessary for the exercise of review powers under this Article."],["a","Article 25: Effect and Supremacy of Exceptional Constitutional Review"],["s","25.1 Purpose"],["c","25.1.1","This Article shall govern the legal effect, authority, and implementation of proceedings conducted under Article 24."],["c","25.1.2","The purpose of this Article is to ensure that the Exceptional Constitutional Review Authority established under Article 24 operates as an effective and enforceable constitutional safeguard."],["s","25.2 Suspension of Ordinary IDC Limitations"],["c","25.2.1","Upon valid invocation of Article 24, the limitations contained within Article 13B.6 shall stand suspended solely in relation to the matter under review."],["c","25.2.2","For the duration of such proceedings:"],["i","(a) the IDC shall not be restricted to an advisory role;"],["i","(b) the IDC shall not be limited to making recommendations only;"],["i","(c) the IDC may exercise the powers granted under Articles 24 and 25."],["c","25.2.3","Such suspension shall be limited strictly to the matter under review and shall not affect ordinary IDC proceedings."],["s","25.3 Constitutional Jurisdiction"],["c","25.3.1","Where Article 24 has been validly invoked, the IDC shall act as the Constitutional Review Authority of TEDxThaltej."],["c","25.3.2","In exercising such jurisdiction, the IDC shall possess authority to:"],["i","(a) interpret the Charter;"],["i","(b) determine compliance with the Charter;"],["i","(c) determine whether favoritism, partiality, abuse of authority, procedural unfairness, or Charter violations have occurred;"],["i","(d) issue binding constitutional determinations."],["s","25.4 Finality of Determinations"],["c","25.4.1","Any determination issued by the IDC under Articles 24 and 25 shall be final and binding."],["c","25.4.2","Such determination shall prevail over:"],["i","(a) recommendations of the Council;"],["i","(b) recommendations of the Core Team;"],["i","(c) decisions relating to the reviewed matter previously taken by the Organizer."],["c","25.4.3","No internal appeal, review, reconsideration, or challenge shall lie against such determination."],["s","25.5 Corrective Authority"],["c","25.5.1","Where a violation is established, the IDC may:"],["i","(a) invalidate the action under review;"],["i","(b) require reconsideration of the action;"],["i","(c) direct corrective measures;"],["i","(d) require uniform application of policy;"],["i","(e) issue governance directives necessary to restore compliance with the Charter."],["c","25.5.2","All authorities, members, committees, and office bearers shall comply with such directives."],["s","25.6 Constitutional Supremacy During Review"],["c","25.6.1","During proceedings under Article 24, this Article shall prevail over:"],["i","(a) Article 3 to the extent of inconsistency;"],["i","(b) Article 4 to the extent of inconsistency;"],["i","(c) Article 13B.6 to the extent of inconsistency."],["c","25.6.2","No provision of this Charter shall be interpreted in a manner that defeats or frustrates the exercise of Constitutional Review Authority under Article 24."],["s","25.7 Restoration of Ordinary Governance"],["c","25.7.1","Upon conclusion of proceedings and implementation of the final determination, all suspended provisions shall automatically resume full force and effect."],["c","25.7.2","Nothing in this Article shall establish the IDC as a permanent superior authority over the Organizer."],["c","25.7.3","The powers conferred under this Article shall exist only for the duration and purpose of a validly invoked Constitutional Review proceeding."],["a","Article 26: Office of the Registrar"],["s","26.1 Establishment"],["c","26.1.1","There shall exist an Office of the Registrar under this Charter."],["c","26.1.2","The Office of the Registrar shall function as the official authority responsible for registration, authentication, certification, attestation, documentation, archival, and maintenance of official records and instruments issued under TEDxThaltej."],["c","26.1.3","The Office of the Registrar shall operate under the authority of the Office of the Organizer and shall derive all powers and functions from this Charter."],["c","26.1.4","The Office of the Registrar shall constitute an institutional office forming part of the Office of the Organizer and shall not exist as an independent governing authority."],["s","26.2 Registrar"],["c","26.2.1","The Registrar shall be appointed by the Organizer."],["c","26.2.2","The Organizer may:"],["i","(a) appoint a Registrar;"],["i","(b) remove a Registrar;"],["i","(c) replace a Registrar;"],["i","(d) appoint Acting Registrars, Deputy Registrars, or other officers of the Office of the Registrar."],["c","26.2.3","The Registrar shall act only within the scope of authority granted under this Charter or delegated by the Organizer."],["s","26.3 Functions"],["c","26.3.1","The Office of the Registrar shall be responsible for:"],["i","(a) registration of official documents and instruments;"],["i","(b) authentication and attestation of records;"],["i","(c) certification of official documents;"],["i","(d) maintenance of institutional records and archives;"],["i","(e) custody and application of the Official Seal;"],["i","(f) issuance of certified copies of official records;"],["i","(g) preservation of institutional history and documentation;"],["i","(h) such other functions as may be assigned by the Organizer."],["s","26.4 Official Seal"],["c","26.4.1","The Official Seal of TEDxThaltej shall remain under the custody of the Office of the Registrar."],["c","26.4.2","The Official Seal may be affixed to documents for the purpose of:"],["i","(a) authentication;"],["i","(b) attestation;"],["i","(c) certification;"],["i","(d) validation of official status."],["c","26.4.3","The Official Seal may exist in physical, digital, or any other officially approved form."],["c","26.4.4","Affixation of the Official Seal by or under the authority of the Office of the Registrar shall constitute official authentication under this Charter."],["s","26.5 Authentication and Certification"],["c","26.5.1","The Office of the Registrar may authenticate, certify, attest, validate, register, or record:"],["i","(a) certificates and recognitions;"],["i","(b) appointment letters;"],["i","(c) Letters of Recommendation;"],["i","(d) policies, provisions, and directives;"],["i","(e) official notices and communications;"],["i","(f) resolutions and records of governance bodies;"],["i","(g) any other official instrument issued under this Charter."],["c","26.5.2","Authentication by the Office of the Registrar shall serve as confirmation of authenticity, issuance, registration, or record and shall not independently create or alter substantive rights."],["s","26.6 Documentation and Archival Requirement"],["c","26.6.1","Any official document, instrument, certificate, letter, notice, communication, policy, provision, order, directive, resolution, recommendation, record, or other matter issued on TEDxThaltej letterhead or through an officially recognized format shall be documented and recorded by the Office of the Registrar."],["c","26.6.2","Every authority, office, committee, body, or individual acting under this Charter shall ensure that a copy of every official instrument issued by them is transmitted to the Office of the Registrar for registration and archival."],["c","26.6.3","No official instrument shall be excluded from documentation solely because it was issued electronically, digitally, or through an authorized communication platform."],["c","26.6.4","The Office of the Registrar shall maintain a permanent register and archive of all official instruments issued under the authority of TEDxThaltej."],["c","26.6.5","Records may be maintained in physical, digital, or hybrid form as determined by the Office of the Organizer."],["c","26.6.6","The records maintained by the Office of the Registrar shall constitute the primary institutional record of TEDxThaltej."],["c","26.6.7","Where any dispute arises regarding the existence, contents, issuance, authenticity, validity, or status of an official instrument, the records maintained by the Office of the Registrar shall be treated as the authoritative institutional record unless otherwise determined by the Organizer."],["s","26.7 Official Communications"],["c","26.7.1","The Office of the Registrar may maintain official communication channels for the discharge of its functions."],["c","26.7.2","Such channels may include institutional email addresses, including but not limited to:"],["p","registrar@tedxthaltejyouth.in"],["p","or such other address as may be designated from time to time."],["c","26.7.3","Any communication, certification, attestation, authentication, registration, notice, or official instrument issued through an authorized communication channel of the Office of the Registrar shall be deemed to have been issued under the authority of the Office of the Organizer unless otherwise specified."],["s","26.8 Legal and Institutional Effect"],["c","26.8.1","Any document authenticated, certified, attested, registered, or sealed by the Office of the Registrar shall be presumed authentic within TEDxThaltej unless revoked, superseded, or proven fraudulent."],["c","26.8.2","The Office of the Registrar shall serve as the central authority for verification of official documents issued under this Charter."],["c","26.8.3","No individual, team, committee, or body shall independently claim authority to authenticate, certify, attest, or seal official TEDxThaltej documents unless authorized under this Charter or by the Organizer."],["s","26.9 Residual Authority"],["c","26.9.1","Nothing in this Article shall diminish or restrict the authority of the Organizer under this Charter."],["c","26.9.2","The Organizer may issue additional provisions governing the structure, operation, powers, procedures, records, and functions of the Office of the Registrar."],["c","26.9.3","The Organizer may at any time expand, reorganize, suspend, dissolve, or reconstitute the Office of the Registrar where necessary for the proper administration of TEDxThaltej."],["a","Article 27: Institutional Integrity Safeguards"],["s","27.1 Purpose and Precedence"],["p","27.1.1 This Article is enacted to close specific structural gaps identified in the operation of Articles 18, 20, 21, 22, 23, and 24, without amending, deleting, or altering the text of those Articles."],["p","27.1.2 Where any provision of this Article is inconsistent with Articles 18, 20, 21, 22, 23, or 24, this Article shall prevail solely to the extent of such inconsistency, in the same manner that Article 24 currently prevails over Articles 3 and 4 during a Constitutional Review."],["p","27.1.3 All other provisions of the Charter not addressed in this Article remain in full force, unaffected."],["s","27.2 Resolution of the Article 21 / Article 22 Liability Conflict"],["p","27.2.1 Where a member acts in execution of a directive issued under Article 21, that member's liability shall be governed exclusively by Article 22.4, and Article 21.6.2 and 21.6.3 shall not apply to that member's individual conduct."],["p","27.2.2 Article 21.6.2 and 21.6.3 shall continue to apply only to the Organizer's own personal conduct in issuing or directing the override, and not to any Core Team member, Director, Head, or other individual carrying out that directive within the scope assigned to them."],["p","27.2.3 A member who exceeds the scope of the directive given to them, or acts in a manner not authorized by the override notice itself, shall not receive the protection of Clause 27.2.1 for the unauthorized portion of their conduct, and shall remain personally liable for that portion under ordinary principles of Article 20."],["p","27.2.4 The conclusive deeming of good faith under Clause 21.6.1(b) shall operate solely for the purpose of the Organizer's liability protection under Article 20, and shall not be interpreted to restrict, foreclose, or prejudge any inquiry into the propriety of the override under Article 24 or Article 25. A determination that an override was, for liability purposes, conclusively in good faith, does not by itself resolve whether that override constituted a misuse of power for the purposes of Clause 24.3.2(e)."],["s","27.3 IDC Chairperson Independence During Active Review"],["p","27.3.1 Once a request for Exceptional Constitutional Review under Article 24 has been submitted with the required Council support under Clause 27.8, and remains pending a jurisdictional decision, the Organizer shall not remove, replace, or reassign the sitting IDC Chairperson until that jurisdictional decision has been made and recorded."],["p","27.3.2 Any removal or replacement of the IDC Chairperson purportedly made during the period described in Clause 27.3.1 shall be of no effect for the purpose of that specific pending review, and the original Chairperson shall be deemed to remain in office solely for the purpose of deciding jurisdiction on that matter."],["p","27.3.3 This restriction applies only to the pending matter in question and does not otherwise limit the Organizer's ordinary power under Article 24.2.2 to appoint, replace, or remove the IDC Chairperson at any other time."],["p","27.3.4 A new IDC Chairperson appointed after a jurisdictional decision has already been made under Clause 27.3.1 shall have no power to reopen, reverse, or reconsider that decision."],["s","27.4 Restriction on Retroactive Amendments Touching Reviewed or Reviewable Matters"],["p","27.4.1 No amendment issued under Article 18 shall be given retroactive effect, under Clause 18.3.1, over any specific decision or action that is, at the time of the amendment's issuance:"],["i","(a) the subject of a pending Exceptional Constitutional Review request under Article 24, whether or not jurisdiction has yet been accepted;"],["i","(b) the subject of a pending IDC inquiry under Article 13B; or"],["i","(c) the subject of a Council-invoked Institutional Hearing under Article 23.4 that has not yet concluded."],["p","27.4.2 An amendment issued while any of the above proceedings is pending may still take effect prospectively from its date of issuance, but shall have no retroactive bearing on the specific matter under review."],["p","27.4.3 This restriction lapses, and full retroactive amendment power under Article 18 resumes, once the relevant proceeding under Clause 27.4.1(a)–(c) has concluded or lapsed without further action."],["s","27.5 Defined Confidentiality Standard for Right to Information"],["p","27.5.1 Where the Organizer withholds information requested under Article 23.3 (RTI) on grounds of confidentiality under Clause 23.3.5(c), the Organizer shall, at minimum, identify which category of confidential information under Clause 16.2.2 the withheld material falls under."],["p","27.5.2 A blanket citation of \"confidentiality\" without reference to a specific category under Clause 16.2.2 shall not satisfy the Organizer's obligation under Clause 23.3.3(a) to provide \"reasonable clarification, reasoning, or context.\""],["p","27.5.3 This Clause does not compel disclosure of the withheld information itself, and creates no appeal, review, or challenge mechanism against the Organizer's confidentiality determination. It solely requires that the basis for withholding be specifically categorized rather than generally asserted."],["s","27.6 Organizer Continuity Pending License Recognition"],["p","27.6.1 The Parties acknowledge that the identity of the Organizer is determined externally, by the individual or entity recognized and approved as licensee by TED Conferences, LLC (\"TED\") under the TEDx program, and not by any internal process of this Charter."],["p","27.6.2 This Clause does not, and cannot, create any internal mechanism to select, appoint, confirm, or remove an Organizer. No provision of this Charter shall be interpreted as conferring Organizer status on any individual who has not been recognized as such by TED."],["p","27.6.3 In the event the sitting Organizer dies, becomes permanently incapacitated, or formally and voluntarily resigns the TEDx license, and a gap arises before TED recognizes a successor licensee, the Core Team shall convene and designate one of its members as Interim Custodian for the sole and limited purpose of:"],["i","(a) maintaining day-to-day continuity of ongoing events, deliverables, and obligations already undertaken by TEDxThaltej;"],["i","(b) preserving institutional records under Article 26;"],["i","(c) communicating with TED regarding the license status."],["p","27.6.4 The Interim Custodian shall not be deemed the Organizer, shall not exercise the powers under Article 4 (including Article 21 override power), and shall act strictly in a caretaker capacity until TED recognizes a successor licensee."],["p","27.6.5 Immediately upon TED's recognition of a successor licensee, the Interim Custodian's role ends automatically, and full Organizer authority under this Charter vests in the newly recognized individual without further internal process."],["p","27.6.6 Nothing in this Clause creates any mechanism to remove a sitting, active, and capable Organizer, nor any internal claim to Organizer status independent of TED's recognition."],["s","27.7 Council Vote Quorum and Verification"],["p","27.7.1 Any threshold expressed elsewhere in this Charter as a fraction or percentage of \"the Council\" (including but not limited to the two-thirds thresholds in Clauses 23.4.1(a) and 24.3.3(a)) shall be calculated against the total number of active Council members recorded as of the date the vote is initiated, and not merely against those who cast a vote."],["p","27.7.2 No vote under Article 23.4 or Article 24.3 shall be considered valid unless independently compiled and verified by the Office of the Registrar under Article 26, which shall confirm the identity of each participating member and the resulting count."],["p","27.7.3 The Office of the Registrar shall record the outcome of such verification in the official archive, regardless of whether the threshold was met."],["s","27.8 Substantiation Requirement and Escalation Tiering"],["p","27.8.1 A request to invoke Exceptional Constitutional Review under Article 24 shall, in addition to the two-thirds Council support required under Clause 24.3.3(a), be accompanied by a written substantiation memorandum, filed with the Office of the Registrar, specifying:"],["i","(a) which specific ground or grounds under Clause 24.3.2(a)–(f) are relied upon;"],["i","(b) the factual basis supporting each ground relied upon; and"],["i","(c) whether an Institutional Hearing under Article 23.4 on the same subject matter has already been conducted, and if not, why one was not sought first."],["p","27.8.2 The absence of a prior Institutional Hearing shall not by itself bar a Constitutional Review request, but the substantiation memorandum required under Clause 27.8.1(c) must address its absence."],["p","27.8.3 The IDC Chairperson shall have regard to the substantiation memorandum in deciding whether to accept jurisdiction under Clause 24.3.3(b), but the memorandum's sufficiency shall not itself be grounds for a separate internal appeal."],["s","27.9 IDC Conflict of Interest Disclosure"],["p","27.9.1 Any member of the IDC, including the Chairperson, who has a direct conflict of interest in a matter before the IDC — whether under ordinary jurisdiction (Article 13B) or Exceptional Constitutional Review (Article 24) — shall disclose that conflict in writing to the Office of the Registrar within a reasonable time of becoming aware of it, and shall recuse themselves from that matter."],["p","27.9.2 Where a conflict is alleged but not voluntarily disclosed, any two other IDC members may jointly raise the matter for resolution."],["p","27.9.3 For matters arising under ordinary IDC jurisdiction (Article 13B), a challenge under Clause 27.9.2 shall be decided by the Organizer."],["p","27.9.4 For matters arising under Exceptional Constitutional Review (Article 24), to preserve the independence of that review from the party whose conduct is under review, a challenge under Clause 27.9.2 concerning any IDC member other than the Chairperson shall be decided by simple majority of the remaining IDC members; a challenge concerning the Chairperson shall be decided by the Council body that invoked the review, by simple majority of those participating."],["s","27.10 Non-Derogation"],["p","27.10.1 This Article shall not be interpreted to diminish the Organizer's authority under Article 4 in any respect other than those specifically and expressly set out in Clauses 27.2 through 27.9 above."],["p","27.10.2 All powers of the Organizer not expressly addressed in this Article remain wholly intact."]];

function charterText_() {
  return CHARTER.map(function (l) { return l[0] === 'c' ? l[1] + ' ' + l[2] : l[1]; }).join('\n');
}
function charterHash_() { return sha_(CHARTER_VERSION + '\n' + charterText_()); }

/** HTML for the PDF. */
function charterHtml_() {
  return CHARTER.map(function (l) {
    if (l[0] === 'a') return '<h2>' + esc_(l[1]) + '</h2>';
    if (l[0] === 's') return '<h3>' + esc_(l[1]) + '</h3>';
    if (l[0] === 'c') return '<p><b>' + esc_(l[1]) + '</b> ' + esc_(l[2]) + '</p>';
    if (l[0] === 'i') return '<p class="it">' + esc_(l[1]) + '</p>';
    return '<p>' + esc_(l[1]) + '</p>';
  }).join('');
}
